generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ReconRowStatus {
  matched
  mismatched
  unmatched_a
  unmatched_b
  duplicate
}

enum ReportStatus {
  draft
  completed
  // Nothing sets this yet — no code path produces a failed run until the
  // actual matching engine exists. Included now for parity with History's
  // "Failed" quick filter so it isn't blocked on a future migration.
  failed
}

enum ExportFormat {
  xlsx
  pdf
}

enum ScheduleCadence {
  daily
  weekly
  monthly
}

enum ReportExportSource {
  manual
  scheduled
}

enum ReportExportStatus {
  success
  failed
}

enum AuditLogStatus {
  success
  info
  warning
  failed
}

enum MemberStatus {
  active
  inactive
}

enum ReportTag {
  bank
  supplier
  year_end
}

model User {
  id        String   @id
  email     String   @unique @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reports          Report[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  reportExports    ReportExport[]
  scheduledReports ScheduledReport[]
  favorites        ReportFavorite[]

  name          String
  emailVerified Boolean      @default(false)
  image         String?
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  // Real, persisted preferences — but nothing in this codebase sends a
  // notification email or a weekly digest yet, so these don't gate
  // anything real today (schema forward-compatibility, same reasoning as
  // ReportStatus.failed).
  emailNotificationsEnabled Boolean @default(true) @map("email_notifications_enabled")
  weeklyDigestEnabled       Boolean @default(false) @map("weekly_digest_enabled")

  @@map("users")
}

model Report {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String       @map("user_id")
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId    String       @map("organization_id")
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status            ReportStatus @default(completed)
  // Nullable: a draft can exist before any file has been chosen yet.
  fileAName         String?      @map("file_a_name") @db.VarChar(255)
  fileBName         String?      @map("file_b_name") @db.VarChar(255)
  name              String?      @db.VarChar(255)
  tag               ReportTag?
  // 0-100; 100 for a completed/failed run, whatever the client reports for
  // an in-progress draft (see services/reportService.js's saveDraft).
  progress          Int          @default(100)
  runDate           DateTime     @default(now()) @map("run_date")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  totalRows         Int          @default(0) @map("total_rows")
  matchedCount      Int          @default(0) @map("matched_count")
  unmatchedCount    Int          @default(0) @map("unmatched_count")
  mismatchedCount   Int          @default(0) @map("mismatched_count")
  duplicateCount    Int          @default(0) @map("duplicate_count")
  totalBreakValue   Decimal      @default(0) @map("total_break_value") @db.Decimal(18, 4)
  amountTolerance   Decimal      @default(0) @map("amount_tolerance") @db.Decimal(10, 4)
  dateToleranceDays Int?         @map("date_tolerance_days")
  config            Json?

  rows      ReportRow[]
  exports   ReportExport[]
  schedules ScheduledReport[]
  favorites ReportFavorite[]

  @@index([userId], map: "idx_reports_user_id")
  @@index([organizationId], map: "idx_reports_organization_id")
  @@index([runDate(sort: Desc)], map: "idx_reports_run_date")
  @@index([userId, status], map: "idx_reports_user_status")
  @@index([organizationId, runDate], map: "idx_reports_org_rundate")
  @@map("reports")
}

model ReportRow {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId   String         @map("report_id") @db.Uuid
  report     Report         @relation(fields: [reportId], references: [id], onDelete: Cascade)
  ref        String         @db.VarChar(500)
  status     ReconRowStatus
  amountA    Decimal?       @map("amount_a") @db.Decimal(18, 4)
  amountB    Decimal?       @map("amount_b") @db.Decimal(18, 4)
  amountDiff Decimal?       @map("amount_diff") @db.Decimal(18, 4)
  dateA      DateTime?      @map("date_a") @db.Date
  dateB      DateTime?      @map("date_b") @db.Date
  rawA       Json?          @map("raw_a")
  rawB       Json?          @map("raw_b")

  @@index([reportId, status], map: "idx_rows_report_status")
  @@index([reportId, ref], map: "idx_rows_ref")
  @@map("report_rows")
}

model AuditLog {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String         @map("user_id")
  user           User           @relation(fields: [userId], references: [id])
  // Nullable + SetNull (unlike Report's cascading organizationId): an audit
  // trail must survive the deletion of the thing it's auditing, including
  // the org.delete entry itself — cascading here would silently destroy the
  // very history that action needs to be recorded in.
  organizationId String?        @map("organization_id")
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  action         String         @db.VarChar(100)
  entityType     String?        @map("entity_type") @db.VarChar(50)
  entityId       String?        @map("entity_id") @db.Uuid
  status         AuditLogStatus @default(success)
  ip             String?        @map("ip_address")
  ts             DateTime       @default(now())
  metadata       Json?

  @@index([userId, ts(sort: Desc)], map: "idx_audit_user_ts")
  @@index([organizationId], map: "idx_audit_organization_id")
  @@index([organizationId, status], map: "idx_audit_organization_status")
  @@map("audit_logs")
}

model Notification {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String       @db.VarChar(100)
  message        String
  entityType     String?      @map("entity_type") @db.VarChar(50)
  entityId       String?      @map("entity_id") @db.Uuid
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([userId, read, createdAt(sort: Desc)], map: "idx_notifications_user_unread")
  @@map("notifications")
}

model ReportTemplate {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // NULL = a system-wide template visible to every org (seeded via migration);
  // non-null = an org's own custom template.
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String        @db.VarChar(100)
  description    String?
  // {summary, matchStatistics, breakAnalysis, unmatchedDetails, chartsAndGraphs}
  sections       Json
  isSystem       Boolean       @default(false) @map("is_system")
  createdAt      DateTime      @default(now()) @map("created_at")

  exports   ReportExport[]
  schedules ScheduledReport[]

  @@index([organizationId])
  @@map("report_templates")
}

model ReportExport {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId       String             @map("report_id") @db.Uuid
  report         Report             @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId         String             @map("user_id")
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String             @map("organization_id")
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Nullable + SetNull: an export's history should survive the template
  // it was generated from later being deleted.
  templateId     String?            @map("template_id") @db.Uuid
  template       ReportTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  // Nullable + SetNull: an export's history should survive the schedule
  // that triggered it later being deleted.
  scheduleId     String?            @map("schedule_id") @db.Uuid
  schedule       ScheduledReport?   @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  source         ReportExportSource @default(manual)
  format         ExportFormat
  status         ReportExportStatus @default(success)
  errorMessage   String?            @map("error_message")
  // Null when status is 'failed' — no file was ever produced.
  fileSizeBytes  Int?               @map("file_size_bytes")
  createdAt      DateTime           @default(now()) @map("created_at")

  @@index([organizationId, createdAt(sort: Desc)], map: "idx_report_exports_org_created")
  @@index([source])
  @@map("report_exports")
}

model ReportFavorite {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportId  String   @map("report_id") @db.Uuid
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, reportId])
  @@index([reportId])
  @@map("report_favorites")
}

model ScheduledReport {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId        String          @map("report_id") @db.Uuid
  report          Report          @relation(fields: [reportId], references: [id], onDelete: Cascade)
  organizationId  String          @map("organization_id")
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String          @map("user_id")
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  cadence         ScheduleCadence
  format          ExportFormat    @default(xlsx)
  templateId      String?         @map("template_id") @db.Uuid
  template        ReportTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  // Same shape as a one-off export's section overrides.
  sections        Json?
  // Nullable array of email strings — a schedule with none is valid: it
  // just keeps a fresh tracked export on file periodically without
  // emailing anyone.
  recipientEmails Json?           @map("recipient_emails")
  isActive        Boolean         @default(true) @map("is_active")
  nextRunAt       DateTime        @map("next_run_at")
  lastRunAt       DateTime?       @map("last_run_at")
  createdAt       DateTime        @default(now()) @map("created_at")

  exports ReportExport[]

  @@index([nextRunAt, isActive], map: "idx_scheduled_reports_due")
  @@index([organizationId])
  @@map("scheduled_reports")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id                       String            @id
  name                     String
  slug                     String
  logo                     String?
  createdAt                DateTime
  metadata                 String?
  // Not part of Better Auth's own org-plugin schema — set/read only by our
  // own settings endpoints, same reasoning as Member.department/status in
  // §6 (no schema.organization.additionalFields config needed). No option
  // list is enforced: the frontend mock has no canonical list for any of
  // these, so inventing one here would be presumptuous.
  orgType                  String?           @map("org_type") @db.VarChar(100)
  country                  String?           @db.VarChar(100)
  timezone                 String?           @db.VarChar(100)
  dateFormat               String?           @map("date_format") @db.VarChar(50)
  currency                 String?           @db.VarChar(10)
  defaultAmountTolerance   Decimal?          @map("default_amount_tolerance") @db.Decimal(10, 4)
  defaultDateToleranceDays Int?              @map("default_date_tolerance_days")
  defaultAmountType        String?           @map("default_amount_type") @db.VarChar(50)
  members                  Member[]
  invitations              Invitation[]
  reports                  Report[]
  auditLogs                AuditLog[]
  notifications            Notification[]
  reportTemplates          ReportTemplate[]
  reportExports            ReportExport[]
  scheduledReports         ScheduledReport[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  // Not part of Better Auth's own org-plugin schema — set/read only by our
  // own team endpoints, so no schema.member.additionalFields config needed.
  status         MemberStatus @default(active)
  department     String?      @db.VarChar(100)
  lastActiveAt   DateTime?    @map("last_active_at")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}
