generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ReconRowStatus {
  matched
  mismatched
  unmatched_a
  unmatched_b
  duplicate
}

enum ReportStatus {
  draft
  completed
  // Nothing sets this yet — no code path produces a failed run until the
  // actual matching engine exists. Included now for parity with History's
  // "Failed" quick filter so it isn't blocked on a future migration.
  failed
}

enum ExportFormat {
  xlsx
  pdf
}

enum ReportExportSource {
  manual
}

enum ReportExportStatus {
  success
  failed
}

enum AuditLogStatus {
  success
  info
  warning
  failed
}

enum MemberStatus {
  active
  inactive
}

enum ReportTag {
  bank
  supplier
  year_end
}

// Only set on unmatched_a/unmatched_b/mismatched/duplicate rows — a matched
// row has nothing to explain. amount_mismatch/date_mismatch are mutually
// exclusive per row (amount checked first when both fail, see
// services/matchingEngine.js); `other` covers same-currency-only rejections.
enum ReconBreakReason {
  amount_mismatch
  missing_counterparty
  missing_internal
  date_mismatch
  duplicate
  other
}

model User {
  id        String   @id
  email     String   @unique @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reports            Report[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  reportExports      ReportExport[]
  favorites          ReportFavorite[]
  reviewedReportRows ReportRow[]         @relation("ReportRowReviewedBy")
  matchRuleTemplates MatchRuleTemplate[]

  name          String
  emailVerified Boolean      @default(false)
  image         String?
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  // Gates report-export recipients who are registered, opted-out org members
  // (services/settingsService.js's filterEmailNotificationOptedIn) — external
  // recipients are unaffected. Weekly Digest moved to Organization (below,
  // org-level/admin-only), not a per-user preference.
  emailNotificationsEnabled Boolean @default(true) @map("email_notifications_enabled")

  @@map("users")
}

model Report {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String       @map("user_id")
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId    String       @map("organization_id")
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status            ReportStatus @default(completed)
  // Set when a run fails during download/parse/match (unparseable file, a
  // missing R2 object, etc.); cleared back to null on a subsequent
  // successful run of the same draft. Only ever populated when status is
  // 'failed'.
  errorMessage      String?      @map("error_message")
  // Nullable: a draft can exist before any file has been chosen yet.
  fileAName         String?      @map("file_a_name") @db.VarChar(255)
  fileBName         String?      @map("file_b_name") @db.VarChar(255)
  name              String?      @db.VarChar(255)
  tag               ReportTag?
  // 0-100; 100 for a completed/failed run, whatever the client reports for
  // an in-progress draft (see services/reportService.js's saveDraft).
  progress          Int          @default(100)
  runDate           DateTime     @default(now()) @map("run_date")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  totalRows         Int          @default(0) @map("total_rows")
  matchedCount      Int          @default(0) @map("matched_count")
  unmatchedCount    Int          @default(0) @map("unmatched_count")
  mismatchedCount   Int          @default(0) @map("mismatched_count")
  duplicateCount    Int          @default(0) @map("duplicate_count")
  totalBreakValue   Decimal      @default(0) @map("total_break_value") @db.Decimal(18, 4)
  amountTolerance   Decimal      @default(0) @map("amount_tolerance") @db.Decimal(10, 4)
  dateToleranceDays Int?         @map("date_tolerance_days")
  config            Json?

  // R2 object keys for the two uploaded files backing a draft — distinct
  // from fileAName/fileBName, which are just display names. Set once the
  // frontend has uploaded to R2 (see routes/files.js's presign endpoint),
  // read by the matching engine at mapping-preview/run time to fetch bytes.
  fileAKey        String?  @map("file_a_key")
  fileBKey        String?  @map("file_b_key")
  // {fileA:{referenceNumber,amount,transactionDate,currency?}, fileB:{...}}
  columnMapping   Json?    @map("column_mapping")
  // Full MatchRuleConfig (superset of amountTolerance/dateToleranceDays
  // above, which stay as their own columns for the existing aggregators to
  // keep reading directly) — sameCurrencyOnly/ignoreCase/ignoreSpaces/
  // trimLeadingZeros/duplicateHandling live here only.
  rulesConfig     Json?    @map("rules_config")
  // Bounded (<=2000 rows/file) preview-time cache so the rule-preview
  // endpoint can re-run cheaply as sliders move, without re-parsing the
  // full file each time. Cleared once /run completes.
  fileASampleRows Json?    @map("file_a_sample_rows")
  fileBSampleRows Json?    @map("file_b_sample_rows")
  // {rows, columns, fileSizeBytes} — also computed at mapping-preview time,
  // but unlike fileASampleRows/fileBSampleRows above, deliberately NOT
  // cleared at completion: Results' File Summary cards need this data on an
  // already-completed report, long after mapping-preview last ran.
  fileASummary    Json?    @map("file_a_summary")
  fileBSummary    Json?    @map("file_b_summary")
  // {matchedValue, unmatchedValue, duplicateValue} — per-status dollar sums
  // Results' stat tiles need alongside their counts; computed once from the
  // match engine's row output at completion time (rows themselves are
  // paginated/queried per-status, not cheaply summable per stat tile).
  valueBreakdown  Json?    @map("value_breakdown")
  // Auto-detected at /run time: the most recent completed report in the org
  // with the same case-insensitive file-pair name, for "vs prior run" deltas
  // and the match-rate trend. Not a user-facing "compare against" picker.
  sourceReportId  String?  @map("source_report_id") @db.Uuid
  sourceReport    Report?  @relation("ReportRerun", fields: [sourceReportId], references: [id], onDelete: SetNull)
  rerunsOf        Report[] @relation("ReportRerun")

  // Human-facing formatted ID (REC-YYYY-NNNNNN), assigned once — the first
  // time a report reaches 'completed' status — via ReportSequence's atomic
  // per-year counter. Drafts and never-completed failed runs stay null; a
  // retry of a previously-failed run keeps whatever sequence it already has
  // rather than getting a new one (see reportService.js's persistCompletedRun).
  sequenceYear   Int? @map("sequence_year")
  sequenceNumber Int? @map("sequence_number")

  rows      ReportRow[]
  exports   ReportExport[]
  favorites ReportFavorite[]

  @@unique([sequenceYear, sequenceNumber])
  @@index([userId], map: "idx_reports_user_id")
  @@index([organizationId], map: "idx_reports_organization_id")
  @@index([runDate(sort: Desc)], map: "idx_reports_run_date")
  @@index([userId, status], map: "idx_reports_user_status")
  @@index([organizationId, runDate], map: "idx_reports_org_rundate")
  @@map("reports")
}

// Backs Report.sequenceNumber's atomic per-year counter — a dedicated row
// per calendar year, incremented via upsert inside the same transaction
// that completes a report, so concurrent completions never collide.
model ReportSequence {
  year      Int @id
  lastValue Int @default(0) @map("last_value")

  @@map("report_sequence")
}

model ReportRow {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId       String            @map("report_id") @db.Uuid
  report         Report            @relation(fields: [reportId], references: [id], onDelete: Cascade)
  ref            String            @db.VarChar(500)
  status         ReconRowStatus
  amountA        Decimal?          @map("amount_a") @db.Decimal(18, 4)
  amountB        Decimal?          @map("amount_b") @db.Decimal(18, 4)
  amountDiff     Decimal?          @map("amount_diff") @db.Decimal(18, 4)
  dateA          DateTime?         @map("date_a") @db.Date
  dateB          DateTime?         @map("date_b") @db.Date
  rawA           Json?             @map("raw_a")
  rawB           Json?             @map("raw_b")
  // Only set for mismatched/unmatched_a/unmatched_b/duplicate rows.
  breakReason    ReconBreakReason? @map("break_reason")
  // "Mark as Reviewed" workflow — reviewedBy is nullable+SetNull so a row's
  // review history survives the reviewing user later being removed.
  reviewed       Boolean           @default(false)
  reviewedBy     String?           @map("reviewed_by")
  reviewedByUser User?             @relation("ReportRowReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?         @map("reviewed_at")

  @@index([reportId, status], map: "idx_rows_report_status")
  @@index([reportId, ref], map: "idx_rows_ref")
  @@index([reportId, breakReason], map: "idx_rows_break_reason")
  @@map("report_rows")
}

model AuditLog {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Nullable + SetNull, same reasoning as organizationId right below: an
  // audit trail must survive the deletion of the thing it's auditing,
  // including the user who performed the action. Previously left at
  // Prisma's default (Restrict), which blocked deleting a user outright the
  // moment they had any audit history — inconsistent with organizationId's
  // own handling of the identical concern.
  userId         String?        @map("user_id")
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Nullable + SetNull (unlike Report's cascading organizationId): an audit
  // trail must survive the deletion of the thing it's auditing, including
  // the org.delete entry itself — cascading here would silently destroy the
  // very history that action needs to be recorded in.
  organizationId String?        @map("organization_id")
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  action         String         @db.VarChar(100)
  entityType     String?        @map("entity_type") @db.VarChar(50)
  // Plain string, not @db.Uuid: entities being audited include both real
  // Postgres-generated UUIDs (Report.id) and Better Auth-managed string ids
  // (Organization.id, User.id, Member.id, Invitation.id) — a strict uuid
  // column silently failed every insert for the latter group.
  entityId       String?        @map("entity_id") @db.VarChar(64)
  status         AuditLogStatus @default(success)
  ip             String?        @map("ip_address")
  ts             DateTime       @default(now())
  metadata       Json?

  @@index([userId, ts(sort: Desc)], map: "idx_audit_user_ts")
  @@index([organizationId], map: "idx_audit_organization_id")
  @@index([organizationId, status], map: "idx_audit_organization_status")
  // Backs getReport's run-duration lookup (report.run.started/completed
  // pair for a given report), which filters on entityType+entityId directly.
  @@index([entityType, entityId], map: "idx_audit_entity")
  @@map("audit_logs")
}

model Notification {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String       @db.VarChar(100)
  message        String
  entityType     String?      @map("entity_type") @db.VarChar(50)
  entityId       String?      @map("entity_id") @db.Uuid
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([userId, read, createdAt(sort: Desc)], map: "idx_notifications_user_unread")
  @@map("notifications")
}

model ReportTemplate {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // NULL = a system-wide template visible to every org (seeded via migration);
  // non-null = an org's own custom template.
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String        @db.VarChar(100)
  description    String?
  // {summary, matchStatistics, breakAnalysis, unmatchedDetails, chartsAndGraphs}
  sections       Json
  isSystem       Boolean       @default(false) @map("is_system")
  createdAt      DateTime      @default(now()) @map("created_at")

  exports ReportExport[]

  @@index([organizationId])
  @@map("report_templates")
}

// A user's saved reconciliation rule-config preset ("Save Template" in
// MatchingRulesSidebar) — distinct from ReportTemplate, which governs export
// section layout, not matching behavior. Always user-owned, no system/seeded
// concept (the mock's own defaults live in Organization's reconciliation
// defaults, §7).
model MatchRuleTemplate {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String       @db.VarChar(100)
  description    String?
  // Full MatchRuleConfig — see routes/reports.js's matchRuleConfigSchema.
  config         Json
  createdAt      DateTime     @default(now()) @map("created_at")
  // Bumped each time this template is selected to start a new
  // reconciliation (ReconciliationOptions' "Saved Template" flow) — not
  // gated on that reconciliation later succeeding, since there's no
  // Report->template link to check completion against.
  lastUsedAt     DateTime?    @map("last_used_at")
  useCount       Int          @default(0) @map("use_count")

  @@index([organizationId])
  @@map("match_rule_templates")
}

model ReportExport {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId       String             @map("report_id") @db.Uuid
  report         Report             @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId         String             @map("user_id")
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String             @map("organization_id")
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Nullable + SetNull: an export's history should survive the template
  // it was generated from later being deleted.
  templateId     String?            @map("template_id") @db.Uuid
  template       ReportTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  source         ReportExportSource @default(manual)
  format         ExportFormat
  status         ReportExportStatus @default(success)
  errorMessage   String?            @map("error_message")
  // Null when status is 'failed' — no file was ever produced.
  fileSizeBytes  Int?               @map("file_size_bytes")
  // R2 object key for the generated file, so a later redownload can serve
  // the stored bytes instead of regenerating (and recording a duplicate
  // export). Null for rows created before this existed, and for failed
  // exports — both fall back to regenerating on download.
  fileKey        String?            @map("file_key")
  createdAt      DateTime           @default(now()) @map("created_at")

  @@index([organizationId, createdAt(sort: Desc)], map: "idx_report_exports_org_created")
  @@index([source])
  @@map("report_exports")
}

model ReportFavorite {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportId  String   @map("report_id") @db.Uuid
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, reportId])
  @@index([reportId])
  @@map("report_favorites")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id                       String              @id
  name                     String
  slug                     String
  logo                     String?
  createdAt                DateTime
  metadata                 String?
  // Not part of Better Auth's own org-plugin schema — set/read only by our
  // own settings endpoints, same reasoning as Member.department/status in
  // §6 (no schema.organization.additionalFields config needed). No option
  // list is enforced: the frontend mock has no canonical list for any of
  // these, so inventing one here would be presumptuous.
  orgType                  String?             @map("org_type") @db.VarChar(100)
  country                  String?             @db.VarChar(100)
  timezone                 String?             @db.VarChar(100)
  dateFormat               String?             @map("date_format") @db.VarChar(50)
  currency                 String?             @db.VarChar(10)
  defaultAmountTolerance   Decimal?            @map("default_amount_tolerance") @db.Decimal(10, 4)
  defaultDateToleranceDays Int?                @map("default_date_tolerance_days")
  // Org-wide, admin-only (not a per-user preference) — when on, every active
  // admin member gets a weekly email + in-app notification summarizing the
  // org's reconciliation activity. See services/weeklyDigestService.js.
  weeklyDigestEnabled      Boolean             @default(false) @map("weekly_digest_enabled")
  // Canonical list of department names admins can assign to members via
  // Member.department (still a plain freeform string, not a FK — this list
  // is a soft steer for the UI, not an enforced constraint on that column).
  departments              String[]            @default([])
  members                  Member[]
  invitations              Invitation[]
  reports                  Report[]
  auditLogs                AuditLog[]
  notifications            Notification[]
  reportTemplates          ReportTemplate[]
  reportExports            ReportExport[]
  matchRuleTemplates       MatchRuleTemplate[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  // Not part of Better Auth's own org-plugin schema — set/read only by our
  // own team endpoints, so no schema.member.additionalFields config needed.
  status         MemberStatus @default(active)
  department     String?      @db.VarChar(100)
  lastActiveAt   DateTime?    @map("last_active_at")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}
